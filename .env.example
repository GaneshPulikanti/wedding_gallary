# Google Drive API Credentials
# Replace with your Google Cloud Developer API Key
VITE_GOOGLE_DEVELOPER_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Google Drive Target Folder ID
# Extract from your Google Drive folder URL: https://drive.google.com/drive/folders/FOLDER_ID_HERE
VITE_GOOGLE_DRIVE_FOLDER_ID=1Y6P9FT0w-AbfHYjtz-YCc6srXvKxwG01

# Polling Interval in milliseconds (default: 7000 ms / 7 seconds)
VITE_POLL_INTERVAL_MS=7000

# Force Mock Data Mode (true/false)
# If set to true or if API key is missing, the app automatically loads realistic demo wedding photos
VITE_USE_MOCK_DATA=false